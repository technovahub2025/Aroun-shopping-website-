# Copy these values into backend/.env. Never put them in frontend VITE_* variables.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
# Optional; leave empty to upload to the authorized account's My Drive root.
GOOGLE_DRIVE_FOLDER_ID=
DRIVE_IMAGE_SIGNING_SECRET=
# Backend origin, without /api. Use your public HTTPS backend origin in production.
PUBLIC_API_URL=http://localhost:5000
